<h1>New post</h1>
<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<%= form_with model: @post do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title, required: true, autofocus: true, placeholder: "Enter the title of you post" %>
  </div>
  <div>
    <%= form.label :text, "Your post" %>
    <%= form.text_area :text, required: true, size: '50x12', placeholder: "Write your post" %>
  </div>
  <%= form.button "Publish", class: "button button-primary"  %>
  <%= form.submit "Publish", class: "button button-primary"  %>
<% end %>